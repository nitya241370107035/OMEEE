# ==========================================
# AeroLens Git Ignore Rules
# ==========================================

# 1. Satellite Imagery, Rasters, Tiles & Previews
*.tif
*.tiff
*.jpg
*.jpeg
*.png
*.webp
*.jp2
*.bmp
*.npy
*.npz
data/tiles/
data/uploads/
data/processed_scenes/
data/cache/
!data/README.md
!data/custom_aoi.geojson

# 2. Reference & External Repositories
SIH2026/

# 3. Python Cache, Bytecode & Testing Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# 4. Virtual Environments
.env
.env.*
!.env.example
.venv/
venv/
ENV/
env/

# 5. IDE, OS & System Generated Logs
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
scratch/
.system_generated/

# 6. Archives & Compressed Dumps
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
