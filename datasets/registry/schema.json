{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DatasetRegistrySchema",
  "description": "Schema definition for multi-domain satellite datasets in the Semantic Image Retrieval and Multi-temporal Satellite Image Analysis project.",
  "type": "object",
  "required": ["datasets"],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dataset_id",
          "display_name",
          "domain",
          "sensor",
          "modality",
          "task",
          "geographic_scope",
          "time_range",
          "spatial_resolution",
          "source",
          "license",
          "local_path",
          "status",
          "notes"
        ],
        "properties": {
          "dataset_id": {
            "type": "string",
            "description": "Unique identifier for the dataset (e.g. eastern_ladakh_s2)."
          },
          "display_name": {
            "type": "string",
            "description": "Human-readable name of the dataset."
          },
          "domain": {
            "type": "string",
            "enum": [
              "pipeline_validation",
              "eastern_ladakh",
              "benchmark_change_detection",
              "maritime"
            ],
            "description": "Domain boundary isolating unrelated datasets."
          },
          "sensor": {
            "type": "string",
            "description": "Platform or sensor (e.g. Sentinel-2 MSI, Sentinel-1 SAR, Various, WorldView)."
          },
          "modality": {
            "type": "string",
            "enum": ["optical", "sar", "multimodal", "multispectral"],
            "description": "Physical modality of the sensor data."
          },
          "task": {
            "type": "string",
            "enum": [
              "preprocessing_validation",
              "temporal_change_detection",
              "semantic_change_detection",
              "ship_detection",
              "semantic_retrieval"
            ],
            "description": "Primary machine learning or analysis task."
          },
          "geographic_scope": {
            "type": "string",
            "description": "Geographical location or coverage area."
          },
          "time_range": {
            "type": "string",
            "description": "Temporal coverage (e.g. 2017-2026, 2017-2023)."
          },
          "spatial_resolution": {
            "type": "string",
            "description": "Ground sampling distance (e.g. ~10m GSD, 0.5m-2.0m)."
          },
          "source": {
            "type": "string",
            "description": "Data provider, STAC endpoint, or original paper."
          },
          "license": {
            "type": "string",
            "description": "Terms of use and license (e.g. CC-BY 4.0, Open Access, Research Use)."
          },
          "local_path": {
            "type": "string",
            "description": "Relative path to local storage under datasets/."
          },
          "status": {
            "type": "string",
            "enum": ["active", "configured", "placeholder", "pending_download", "archived"],
            "description": "Operational readiness status."
          },
          "notes": {
            "type": "string",
            "description": "Technical notes, configuration constraints, or provenance remarks."
          }
        }
      }
    }
  }
}
